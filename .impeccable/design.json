  "narrative": {
    "northStar": "The rehearsal studio",
    "overview": "I use the visual language of a working rehearsal room: a quiet monitor surface, a legible script and a restrained cue color. Film influence lives in the condensed titles and the separation of camera, dialogue and controls. Familiar controls keep the visual identity subordinate to the actor's task.\n\nThis records the implemented system in `src/styles.css` and `src/ui/App.tsx`. The final Cuelira name and tagline remain fixed. Page-specific composition belongs to the surface brief; future screens inherit the palette, typography and component behavior rather than reproducing one layout everywhere.",
    "keyCharacteristics": [
      "Condensed film-title typography paired with plain working text.",
      "Dark studio surfaces and a pale, high-contrast script.",
      "Mint as an action, cue and accepted-state color.",
      "Flat tonal hierarchy, compact controls and deliberate state motion.",
      "Explicit captions, camera status and manual-action provenance."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair signal colors with explicit text. An accepted observation, manual continuation, camera-off state or error must remain understandable without color.",
        "section": "colors"
      },
      {
        "name": "The Working Text Rule",
        "body": "Use Public Sans for dialogue, buttons, labels and measurements; condensed type is for identity and titles. Timers and event timestamps use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat Studio Rule",
        "body": "Keep ordinary surfaces shadow-free. Use the existing tone and border roles to express grouping and state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing color and font roles through the root CSS tokens.",
      "Do keep the primary rehearsal controls reachable at the supported minimum window size.",
      "Do preserve speaker captions and honest manual-versus-SDK labels.",
      "Do provide immediate keyboard focus and honor reduced motion.",
      "Do show a genuine unavailable or camera-off state when evidence is absent."
    ],
    "donts": [
      "Don't replace the fixed Cuelira name, tagline or original mark.",
      "Don't introduce generic AI illustrations, random gradients or unnecessary neon.",
      "Don't use decorative animation that competes with dialogue or live observation.",
      "Don't turn expression categories into psychological or acting-quality judgments.",
      "Don't treat inherited small footer/data text or reduced footer hit areas as a new accessibility standard."
    ]
  }
}
