{
  "name": "cuelira",
  "version": "0.1.0",
  "private": true,
  "description": "Your scene responds to you. A live self-tape rehearsal partner.",
  "author": "Udeorji Sopuruchi Juliana",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:gui": "playwright test",
    "check": "npm run build && npm test && npm run test:gui",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux --x64 --dir",
    "assets": "node scripts/brand.mjs",
    "security": "node scripts/security.mjs",
    "video:studio": "node scripts/video.mjs studio",
    "video:proof": "node scripts/video.mjs proof",
    "video:render": "node scripts/video.mjs render"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.6",
    "@fontsource/public-sans": "5.2.7",
    "@smartspectra/node-sdk": "3.5.0",
    "dotenv": "17.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "electron": "43.8.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.0",
    "opentype.js": "1.3.4",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "com.cuelira.rehearsal",
    "productName": "Cuelira",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/brand/icon.png",
      "LICENSE",
      "node_modules/**",
      "!node_modules/@smartspectra/node-sdk-*/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/brand/icon.ico",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-win32-${arch}/",
          "to": "smartspectra"
        }
      ]
    },
    "linux": {
      "target": "dir",
      "icon": "assets/brand/icon.png",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-linux-${arch}/",
          "to": "smartspectra"
        }
      ]
    },
    "npmRebuild": false,
    "copyright": "Copyright © 2026 Udeorji Sopuruchi Juliana"
  },
  "overrides": {
    "minimatch@^9.0.0 || ^10.0.0": "11.0.1"
  }
}
